HTTP_PORT=8081

# local default below; dev/production use an in-cluster broker (amqps://user:pass@host/vhost for CloudAMQP)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JOB_QUEUE=job_status_event
MONGO_URI=mongodb://localhost:27017
MONGO_DB=proteng_local

# LOCAL ONLY: set to http://localhost:4443 to read artifacts from fake-gcs
# (make infra-up in manual-guides-2023). Leave empty on dev/production.
STORAGE_EMULATOR_HOST=

# GCP service account used for GCS artifact storage (storage/storage_service.go)
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
TOKEN_URI=