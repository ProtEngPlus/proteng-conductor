JOB_QUEUE=job_status_event
MONGO_URI=mongodb://localhost:27017
MONGO_DB=proteng_local

# GCP service account used for GCS artifact storage (storage/storage_service.go)
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
TOKEN_URI=